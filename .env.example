# --- core ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGO=HS256
JWT_EXPIRE_MINUTES=720
APP_ENV=dev
LOG_LEVEL=INFO

# --- database ---
POSTGRES_USER=base
POSTGRES_PASSWORD=base
POSTGRES_DB=base
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://base:base@postgres:5432/base

# --- redis / queue ---
REDIS_URL=redis://redis:6379/0

# --- admin bootstrap ---
BOOTSTRAP_ADMIN_EMAIL=admin@base.local
BOOTSTRAP_ADMIN_PASSWORD=admin

# --- source API keys (all optional) ---
SHODAN_API_KEY=
CENSYS_API_ID=
CENSYS_API_SECRET=
VIRUSTOTAL_API_KEY=
SECURITYTRAILS_API_KEY=
GREYNOISE_API_KEY=
ABUSEIPDB_API_KEY=
IPINFO_TOKEN=
URLSCAN_API_KEY=
HIBP_API_KEY=
OTX_API_KEY=
OPENCORPORATES_API_KEY=

# --- limits ---
HTTP_TIMEOUT_SECONDS=20
MAX_CONCURRENT_COLLECTORS=8
RATE_LIMIT_PER_MINUTE=120
